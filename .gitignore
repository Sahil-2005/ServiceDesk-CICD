@'
# Java / Maven
backend/target/
*.class
*.jar
*.war

# Node / React / Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE files
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/
temp/
'@ | Set-Content -Encoding utf8 .gitignore